  (def-var-with-meta! "jolt.passes.inline" "stamp-inline" (let* ((_kc$16368 (keyword #f "inline-chain")) (_kc$16369 (jolt-vector)) (_kc$16372 (keyword #f "fn")) (_kc$16373 (keyword #f "op")) (_kc$16375 (jolt-var "jolt.ir" "map-ir-children"))) (letrec ((stamp-inline (lambda (node fqn at outer) (let fnrec16367 ((node node) (fqn fqn) (at at) (outer outer)) (let* ((n (if (jolt-truthy? at) (jolt-assoc3 node _kc$16368 (jolt-into (let* ((_a$16370 (let* ((or__33__auto (jolt-get node _kc$16368))) (if (jolt-truthy? or__33__auto) or__33__auto _kc$16369))) (_a$16371 (jolt-vector fqn at))) (jolt-conj2 _a$16370 _a$16371)) outer)) node))) (if (jolt=2 _kc$16372 (jolt-get node _kc$16373)) n (let* ((_a$16376 (var-cell-deref _kc$16375)) (_a$16377 (lambda (c) (let fnrec16374 ((c c)) (stamp-inline c fqn at outer)))) (_a$16378 n)) (jolt-invoke2 _a$16376 _a$16377 _a$16378)))))))) stamp-inline)) (jolt-hash-map (keyword #f "private") #t (keyword #f "arglists") (jolt-list (jolt-vector (jolt-symbol #f "node") (jolt-symbol #f "fqn") (jolt-symbol #f "at") (jolt-symbol #f "outer"))) (keyword #f "doc") "Record, on every node of a callee body, the logical frames a backtrace should\n  report for it \x2014; the inline equivalent of a DWARF inline record.\n\n  :inline-chain is a vector of [callee-fqn call-line] pairs, INNERMOST FIRST.\n  Each entry says \"the code here belongs to callee-fqn, which was called at\n  call-line of the next frame out\"; the last entry's call-line is a line in the\n  physical fn the whole thing ended up inside. Reading it back: the node's own\n  line locates the first entry's fn, entry i's call-line locates entry i+1's, and\n  the final call-line locates the physical fn (source-registry jolt-site-frame*).\n\n  APPENDS rather than overwrites, which is what makes nesting work. inline-node\n  runs bottom-up, so when C is spliced into P the body already carries whatever\n  chain an earlier splice into C left; appending [C at] puts P's view outside it.\n  deep-boom spliced into mid-boom spliced into -main ends up\n  [[deep-boom 70] [mid-boom 31]], and reports three frames.\n\n  `outer` is the chain the CALL SITE already carried, and it goes on the end of\n  every stamped node. Without it a splice into an already-spliced region loses\n  everything above the region: mid-boom is spliced into -main, the fixpoint then\n  splices deep-boom into that copy, and deep-boom's nodes would claim\n  [[deep-boom 70]] alone \x2014; naming -main at a line in another file.\n\n  Applied to the callee body BEFORE subst, never after: subst replaces params\n  with CALLER expressions, and those did not come from the callee \x2014; stamping the\n  result would attribute the caller's own code to it." (keyword #f "line") 267 (keyword #f "column") 1)))
