;; Deterministic materialization parity; no timing pass criterion.
(import (chezscheme))
(load "host/chez/rt.ss")
(define (check label actual expected)
  (unless (equal? actual expected)
    (error 'materialize label actual expected)))
(define (sink prefix)
  ;; Use the runtime constructor, not the retired three-slot writer store.
  ;; This fixture exclusively owns its writer; the guarded native seam and
  ;; shared StringBuffer monitor have separate concurrency/ownership gates.
  (let ((writer (host-new "StringWriter")))
    (sb-append! writer prefix)
    writer))
(define pieces '#("" "a" "BC" "λ😀" "\n\"\\" "longer-piece"))
(for-each
 (lambda (size)
   (let ((writer (sink "base:λ")) (expected "base:λ"))
     (do ((i 0 (+ i 1))) ((= i size))
       (let ((piece (vector-ref pieces (modulo i (vector-length pieces)))))
         (sb-append! writer piece)
         (set! expected (string-append expected piece))))
     (let* ((state (jhost-state writer)) (pending (vector-ref state 5)))
       (check "non-flushing length" (sb-length writer) (string-length expected))
       (unless (eq? pending (vector-ref state 5))
         (error 'materialize "length changed pending chunks"))
       (let ((first (sb-str writer)))
         (check "ordered contents" first expected)
         (unless (eq? first (vector-ref state 3))
           (error 'materialize "materialization is not cached"))
         (let ((joined (vector-ref state 5)))
           (unless (and (pair? joined) (eq? first (car joined)) (null? (cdr joined)))
             (error 'materialize "materialization did not coalesce pending pieces")))
         (check "logical length after materialization" (vector-ref state 1)
                (string-length expected))
         (check "materialization does not flush indexed buffer" (vector-ref state 6) 0)
         (unless (eq? first (sb-str writer))
           (error 'materialize "repeat read did not reuse materialization"))
         (check "indexed read" (sb-char-at writer 0) #\b)
         (check "indexed read flushes pending pieces" (vector-ref state 5) '())
         (check "indexed buffer length" (vector-ref state 6) (string-length expected))
         (unless (eq? first (sb-str writer))
           (error 'materialize "indexed read discarded cached materialization"))
         (sb-append! writer "tail😀")
         (check "append after read" (sb-str writer) (string-append expected "tail😀"))
         (check "retained prior read" first expected)
         (sb-set! writer "reset:")
         (sb-append! writer "x")
         (sb-append! writer "yz")
         (check "reset and asymmetric append" (sb-str writer) "reset:xyz")
         (check "retained read after reset" first expected)))))
 '(0 1 2 3 17 128 1024))
(let ((a (sink "A:")) (b (sink "B:")))
  (sb-append! a "1") (sb-append! b "22")
  (sb-append! a "333") (sb-append! b "4")
  (check "independent sink A" (sb-str a) "A:1333")
  (check "independent sink B" (sb-str b) "B:224"))
(display "string-builder-materialize: PASS\n")
