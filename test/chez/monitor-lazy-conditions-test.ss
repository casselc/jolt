;; Lazy native wait machinery must not change monitor ownership/wakeup rules.
(import (chezscheme))
(load "host/chez/run-gate-harness.ss")
(define m (make-monitor))
(gate-check "fresh entry condition absent" (vector-ref m monitor-i-cv) #f)
(gate-check "fresh Object.wait condition absent" (vector-ref m monitor-i-wcv) #f)
(do ((i 0 (+ i 1))) ((= i 100))
  (monitor-enter! m) (monitor-enter! m)
  (monitor-exit! m) (monitor-exit! m))
(gate-check "uncontended entry remains thin" (vector-ref m monitor-i-cv) #f)
(gate-check "uncontended exit does not allocate wait set" (vector-ref m monitor-i-wcv) #f)
(define c1 (jolt-with-mutex (vector-ref m monitor-i-bk)
             (monitor-condition-under-bk! m monitor-i-cv)))
(define c2 (jolt-with-mutex (vector-ref m monitor-i-bk)
             (monitor-condition-under-bk! m monitor-i-cv)))
(gate-check "entry condition installed only once" (eq? c1 c2) #t)
(gate-check "entry allocation leaves wait condition absent" (vector-ref m monitor-i-wcv) #f)

(define waiting (make-monitor))
(monitor-enter! waiting) (monitor-enter! waiting)
(monitor-object-wait! waiting 1)
(gate-check "Object.wait installs condition" (and (vector-ref waiting monitor-i-wcv) #t) #t)
(gate-check "Object.wait without contenders leaves entry condition absent"
            (vector-ref waiting monitor-i-cv) #f)
(gate-check "Object.wait restores reentrant depth" (monitor-self-count waiting) 2)
(monitor-exit! waiting) (monitor-exit! waiting)

;; A real blocked native contender must be covered by an installed entry CV
;; before the owner can broadcast. No synthetic spurious wake rescues the test.
(define contended (make-monitor))
(define done-mu (make-mutex))
(define done #f)
(define child-error #f)
(monitor-enter! contended)
(fork-thread
  (lambda ()
    (guard (e (#t (with-mutex done-mu (set! child-error e))))
      (monitor-enter! contended)
      (monitor-exit! contended))
    (with-mutex done-mu (set! done #t))))
(define (await label predicate)
  (let ((start (current-time 'time-monotonic)))
    (let loop ()
      (unless (predicate)
        (when (> (time-second (time-difference (current-time 'time-monotonic) start)) 5)
          (error 'lazy-monitor label))
        (sleep (make-time 'time-duration 1000000 0))
        (loop)))))
(await "contender never installed entry CV"
       (lambda () (jolt-with-mutex (vector-ref contended monitor-i-bk)
                    (and (vector-ref contended monitor-i-cv) #t))))
(gate-check "contender did not allocate Object.wait CV" (vector-ref contended monitor-i-wcv) #f)
(monitor-exit! contended)
(await "contender lost release wake" (lambda () (with-mutex done-mu done)))
(gate-check "native contender completed without exception" child-error #f)
(gate-summary "lazy monitor conditions")
