(import (chezscheme))
(load "host/chez/run-gate-harness.ss")
(define m (make-monitor))
(gate-check "fresh monitor has no backing mutex" (vector-ref m monitor-i-bk) #f)
(define original-publish monitor-publish-backing-mutex!)
(define tries 0)
(define candidates '())
(define got #f)
(dynamic-wind
  (lambda ()
    (set! monitor-publish-backing-mutex!
      (lambda (mon candidate)
        (set! tries (+ tries 1))
        (set! candidates (cons candidate candidates))
        (and (> tries 2) (original-publish mon candidate)))))
  (lambda () (set! got (monitor-backing-mutex! m)))
  (lambda () (set! monitor-publish-backing-mutex! original-publish)))
(gate-check "spurious failures really injected" (>= tries 3) #t)
(gate-check "retry reuses one candidate" (for-all (lambda (v) (eq? v got)) candidates) #t)
(gate-check "winner stored before return" (eq? got (vector-ref m monitor-i-bk)) #t)
(gate-check "warm identity stable" (eq? got (monitor-backing-mutex! m)) #t)

;; A loser must return the installed mutex, never its own unused candidate.
(define losing (make-monitor))
(define winner (make-mutex))
(dynamic-wind
  (lambda ()
    (set! monitor-publish-backing-mutex!
      (lambda (mon candidate)
        (unless (vector-ref mon monitor-i-bk)
          (let install () (unless (original-publish mon winner) (install))))
        (original-publish mon candidate))))
  (lambda ()
    (gate-check "loser returns published winner" (eq? winner (monitor-backing-mutex! losing)) #t))
  (lambda () (set! monitor-publish-backing-mutex! original-publish)))

;; Four real cold readers reach publication before any can win.
(define cold (make-monitor))
(define barrier (make-mutex))
(define barrier-cv (make-condition))
(define arrived 0)
(define done 0)
(define results '())
(define errors 0)
(set! monitor-publish-backing-mutex!
  (lambda (mon candidate)
    (with-mutex barrier
      (set! arrived (+ arrived 1))
      (condition-broadcast barrier-cv)
      (let await () (when (< arrived 4) (condition-wait barrier-cv barrier) (await))))
    (original-publish mon candidate)))
(do ((i 0 (+ i 1))) ((= i 4))
  (fork-thread
    (lambda ()
      (guard (e (#t (with-mutex barrier (set! errors (+ errors 1)))))
        (let ((v (monitor-backing-mutex! cold)))
          (with-mutex barrier (set! results (cons v results)))))
      (with-mutex barrier (set! done (+ done 1))))))
(define started (current-time 'time-monotonic))
(let await ()
  (unless (with-mutex barrier (= done 4))
    (when (> (time-second (time-difference (current-time 'time-monotonic) started)) 5)
      (error 'lazy-backing "cold readers failed to complete"))
    (sleep (make-time 'time-duration 1000000 0))
    (await)))
(set! monitor-publish-backing-mutex! original-publish)
(gate-check "cold readers all completed" (and (= errors 0) (= (length results) 4)) #t)
(gate-check "all cold readers use installed winner"
            (for-all (lambda (v) (eq? v (vector-ref cold monitor-i-bk))) results) #t)
(monitor-enter! cold) (monitor-enter! cold)
(gate-check "queries use initialized backing mutex" (monitor-self-count cold) 2)
(monitor-exit! cold) (monitor-exit! cold)
(gate-summary "lazy monitor backing mutex")
