;; Shared store identity, lock-at-mutation and exception-safe reentrancy.
(import (chezscheme))
(load "host/chez/run-gate-harness.ss")
(define writer (host-new "StringWriter"))
(define state (jhost-state writer))
(define owner (vector-ref state 2))
(define monitor (vector-ref state 4))
(define original-capacity (vector-ref state 7))
(gate-check "writer and getBuffer share one state" (eq? state (jhost-state owner)) #t)
(gate-check "stored monitor is buffer's object monitor" (eq? monitor (object-monitor owner)) #t)
(sb-append*! writer "old")
(sb-append*! owner "-pending")
(define snapshot (sb-str* writer))
(sb-set! writer "new")
(gate-check "replacement visible through writer" (sb-str* writer) "new")
(gate-check "replacement visible through shared buffer" (sb-str* owner) "new")
(gate-check "prior immutable text remains unchanged" snapshot "old-pending")
(sb-append*! owner "!")
(gate-check "later shared-buffer append visible through writer" (sb-str* writer) "new!")
(sb-set! owner "\x03bb;\x1f680;")
(gate-check "replacement through buffer updates writer with Unicode" (sb-str* writer) "\x03bb;\x1f680;")
(gate-check "replacement length follows runtime string indexing" (sb-length* writer) 2)
(sb-set! writer (make-string 300 #\x))
(gate-check "replacement grows capacity" (>= (vector-ref state 7) 300) #t)
(define grown-capacity (vector-ref state 7))
(sb-set! writer "")
(gate-check "clear resets text and pending pieces" (sb-str* owner) "")
(gate-check "clear resets length" (sb-length* writer) 0)
(gate-check "clear retains capacity" (vector-ref state 7) grown-capacity)
(gate-check "capacity never shrinks below original" (>= grown-capacity original-capacity) #t)
(gate-check "replacement preserves buffer owner" (eq? owner (vector-ref state 2)) #t)
(gate-check "replacement preserves monitor" (eq? monitor (vector-ref state 4)) #t)
(gate-check "replacement preserves shared state" (eq? state (jhost-state owner)) #t)

;; Observe the actual production mutation's first helper. A naked replacement
;; mutant cannot satisfy this check merely by preserving the monitor field.
(let ((grow %sb-grow-cap!) (depths '()))
  (dynamic-wind
    (lambda ()
      (set! %sb-grow-cap!
        (lambda (st minimum)
          (set! depths (cons (monitor-self-count monitor) depths))
          (grow st minimum))))
    (lambda ()
      (%sb-grow-cap! state 1)
      (gate-check "control: unlocked helper has zero lock depth" (car depths) 0)
      (sb-set! writer "locked")
      (gate-check "replacement holds shared monitor during mutation" (car depths) 1)
      (jolt-call-with-monitor monitor
        (lambda ()
          (sb-set! writer "reentrant")
          (gate-check "replacement is reentrant on existing monitor" (car depths) 2)
          (gate-check "replacement restores outer monitor depth" (monitor-self-count monitor) 1)))
      (gate-check "replacement releases monitor on return" (monitor-self-count monitor) 0))
    (lambda () (set! %sb-grow-cap! grow))))
(let ((grow %sb-grow-cap!) (sentinel (vector 'failed)))
  (dynamic-wind
    (lambda () (set! %sb-grow-cap! (lambda args (raise sentinel))))
    (lambda ()
      (gate-check "replacement exception is unchanged"
        (guard (e (else (eq? e sentinel))) (sb-set! writer "not-installed") #f) #t)
      (gate-check "failed replacement releases shared monitor" (monitor-self-count monitor) 0))
    (lambda () (set! %sb-grow-cap! grow))))
(gate-check "failure before replacement leaves prior text intact" (sb-str* owner) "reentrant")
(let ((builder (host-new "StringBuilder")))
  (sb-set! builder "plain")
  (gate-check "unsynchronized builder retains replacement support" (sb-str* builder) "plain"))
(gate-summary "Synchronized writer replacement")
